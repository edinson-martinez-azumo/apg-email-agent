{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "build": {
    "command": "cd backend && uv sync && uv run alembic upgrade head"
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/api/index.py" },
    { "src": "/(.*\\.[a-zA-Z0-9]+)", "dest": "frontend/$1" },
    { "src": "/(.*)", "dest": "frontend/index.html" }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/poll-gmail",
      "schedule": "0 0 * * *"
    }
  ]
}
