# ── Backend ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/apgdb
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Gmail OAuth2 — create at console.cloud.google.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.compose

# Polling interval (minutes)
POLL_INTERVAL_MINUTES=5

# ── Frontend ───────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── Production (injected by Vercel) ────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/dbname?ssl=require
# NOTE: asyncpg requires ssl=require — NOT sslmode=require
# VITE_API_URL=https://your-project.vercel.app
# FRONTEND_URL=https://your-project.vercel.app
